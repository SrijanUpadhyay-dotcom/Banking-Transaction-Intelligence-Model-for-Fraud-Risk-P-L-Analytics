# ─── Banking Transaction Intelligence Model ───────────────────────────────────
# Copy this file to .env and fill in your values. Never commit .env to git.

# ── Application ───────────────────────────────────────────────────────────────
BTI_ENVIRONMENT=production
BTI_LOG_LEVEL=INFO

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, no setup required):
BTI_DATABASE_URL=sqlite:///./data/bti.db

# PostgreSQL (production recommended):
# BTI_DATABASE_URL=postgresql://bti_user:CHANGE_ME@localhost:5432/bti_db

# ── Security ──────────────────────────────────────────────────────────────────
BTI_SECRET_KEY=CHANGE_ME_USE_A_LONG_RANDOM_STRING_OF_AT_LEAST_32_CHARS
BTI_API_KEY=CHANGE_ME_API_KEY_FOR_EXTERNAL_CLIENTS

# ── Email Alerts ──────────────────────────────────────────────────────────────
BTI_SMTP_HOST=smtp.gmail.com
BTI_SMTP_PORT=587
BTI_SMTP_USER=your-alert-account@gmail.com
BTI_SMTP_PASSWORD=CHANGE_ME

# ── Webhook Alerts ────────────────────────────────────────────────────────────
BTI_WEBHOOK_URL=https://hooks.yourbank.internal/bti-alerts
BTI_WEBHOOK_SECRET=CHANGE_ME

# ── Feature Flags ─────────────────────────────────────────────────────────────
BTI_ALERTS_ENABLED=true
BTI_AUDIT_ENABLED=true
